# Copy this file to /etc/default/config-wifi and set permissions to 0600.
# Do not commit real secrets in git.

# Required values
WIFI_ID=""
WIFI_NAME=""
WIFI_SSID_HEX=""

# Optional (default: 2412)
WIFI_FREQUENCY="2422"

# Choose ONE of the following:
# 1) Inline passphrase (avoid this in production images)
WIFI_PASSPHRASE=""

# 2) Preferred: read passphrase from a root-only file
# WIFI_PASSPHRASE_FILE="/etc/secret/wifi_passphrase"
